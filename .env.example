# Copy this file to .env before running Docker Compose locally.
# Do not commit your real .env file.

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=bit_forum

SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=change-me

# Must be at least 32 bytes for HS256 signing.
JWT_SECRET=replace-with-a-random-32-byte-minimum-secret
JWT_EXPIRATION=604800000

# DeepSeek 大模型 API Key（M13 起使用）。
# 用途：论坛 AI Agent 的对话、工具调用、内容审核、运营分析。
# 获取地址：https://platform.deepseek.com/api_keys
# 保留非空占位值并关闭聊天；显式启用后才注入真实密钥，勿提交本机 .env。
DEEPSEEK_API_KEY=disabled-placeholder-key-not-used

# Safe single-machine default; opt-in model use requires separate credentials and authorization.
DEEPSEEK_CHAT_ENABLED=false
BITFORUM_RECOMMEND_REASON_ENABLED=false
BITFORUM_MODERATION_AUTO_APPROVE=false
BITFORUM_QA_ALLOW_WRITE_TOOLS=false

# Local opt-in chat uses the official endpoint and the fixed non-thinking Flash client.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Each question uses at most one external model request when tools are disabled.
BITFORUM_QA_TOOLS_ENABLED=false
BITFORUM_MODERATION_MODEL_ENABLED=false
BITFORUM_ANALYST_MODEL_ENABLED=false
